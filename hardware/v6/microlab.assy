links:
  - assembly: control-unit
    name: control-unit
  - assembly: heating-unit
    name: heating-unit
    location: [[225, 250, 169], [0, 1, 0], 180]
  - assembly: cooling-unit
    name: cooling-unit
    location: [[571, 250, 169], [0, 1, 0], 180]
  - assembly: reactor-unit
    name: reactor-unit
    location: [[300, 100, 0], [1, 0, 0], 0]

  {% for unit in ['heat', 'cool'] %}
  {% for tube in ['pump-to-core', 'pump-to-coil', 'coil-to-core'] %}
  - part: tube-{{ unit }}-{{ tube }}
    name: tube-{{ unit }}-{{ tube }}
  {% endfor %}
  {% endfor %}

  {% for pump in ['x', 'y', 'z'] %}
  - part: tube-reagent-pump-{{ pump }}
    name: tube-reagent-pump-{{ pump }}
  {% endfor %}

  - part: thermistor-probe
    name: thermistor-probe
    location: [[398, 141.2, 123], [0, 0, 1], 0]
  - part: thermistor-cable
    name: thermistor-cable
  - part: thermistor-dongle
    name: thermistor-dongle
    location: [[86.5, 188, 21], [0, 0, 1], 0]
