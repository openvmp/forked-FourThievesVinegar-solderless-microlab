links:
  - assembly: control-unit
    name: control-unit
  - assembly: heating-unit
    name: heating-unit
    location: [[225, 250, 169], [0, 1, 0], 180]
  - assembly: cooling-unit
    name: cooling-unit
    location: [[571, 250, 169], [0, 1, 0], 180]
  - assembly: reactor-unit
    name: reactor-unit
    location: [[300, 100, 0], [1, 0, 0], 0]

  {% for unit in ['heat', 'cool'] %}
  {% for tube in ['pump-to-core', 'pump-to-coil', 'coil-to-core'] %}
  - part: tube-{{ unit }}-{{ tube }}
    name: tube-{{ unit }}-{{ tube }}
  {% endfor %}
  {% endfor %}

  {% for pump in ['x', 'y', 'z'] %}
  - part: tube-reagent-pump-{{ pump }}
    name: tube-reagent-pump-{{ pump }}
  {% endfor %}

  - assembly: thermistor
    name: thermistor
    connect:
      withInstance: plug
      toInstance: usb-lower
      name: control-unit
