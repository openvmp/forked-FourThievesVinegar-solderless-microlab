{% if param_profile == 'flat' %}
{%   set profile_prefix = "-flat" %}
{% else %}
{%   set profile_prefix = "" %}
{% endif %}

links:
  - part: control-box{{ profile_prefix }}
    name: box

  - part: //pub/electronics/sbcs/raspberrypi:rpi4b
    name: rpi
    connectPorts:
      with: corner-bottom-front-left
      name: box
      to: rpi
      # method: slide
      # slide: [10, 0, 0]
      # slideSecondary: [0, 0, 50]

  - part: //pub/electronics/sbcs/arduino:unoR3
    name: unoR3
    connectPorts:
      with: corner-bottom-back-left
      name: box
      to: uno
      # method: slide
      # slide: [0, 10, 0]
      # slideSecondary: [0, 0, 50]

  - part: cnc-shield
    name: cnc-shield
    connectPorts:
      with: uno
      name: unoR3
      to: corner-bottom-back-left

  - part: rpi-lcd-35
    name: screen
    connectPorts:
      with: rpi
      name: rpi
      to: corner-bottom-front-left

{% if param_profile == 'flat' %}
  - part: relay-case-no-top
    name: relay-case
    connectPorts:
      with: board
      name: box
      to: relay-case

  - part: relay-board
    name: relay-board
    connectPorts:
      with: case
      name: relay-case
      to: board

  - part: //pub/std/metric/cqwarehouse:fastener/raisedcheesehead-iso7045
    name: relay-case-screw
    params:
      size: M3-0.5
      length: 12
    connect:
      toInstance: tab-top
      name: relay-case

  - part: stepdown-case
    name: stepdown-case
    connectPorts:
      with: board
      name: box
      to: stepdown-case

  - part: stepdown-converter
    name: stepdown-converter
    connectPorts:
      with: case
      name: stepdown-case
      to: board

  - part: lever-connector
    name: wire-connector
    connectPorts:
      with: floor
      name: box
      to: wire-connector
{% endif %}

{% for pins in [8, 12, 2] %}
  - part: panel-connector-{{ pins }}
    name: connector-{{ pins }}
    connectPorts:
      with: wall
      name: box
      to: connector-{{ pins }}
{% endfor %}

{% for port in ['usb-upper', 'usb-lower'] %}
  - part: usb-panel-socket
    name: {{ port }}
    connectPorts:
      with: wall
      name: box
      to: {{ port }}
{% endfor %}

  - part: barrel-jack
    name: barrel-jack
    connectPorts:
      with: wall
      name: box
      to: barrel-jack

  - part: control-box-lid{{ profile_prefix }}
    name: lid
    connect:
      withInstance: inner-right
      withParams:
        # TODO(clairbee): drop tunrZ when two-port match is supported
        turnZ: 90
      toInstance: outer-right
      name: box
      # method: slide
      # slide: [0, 30, 0]
      # slideSecondary: [0, 0, 10]

  - part: //pub/std/metric/cqwarehouse:fastener/{{ param_screw_type }}
    # name: right-screw
    params:
      size: M3-0.5
      length: 16
    connect:
      toInstance: outer-right
      name: lid
        
  - part: //pub/std/metric/cqwarehouse:fastener/{{ param_screw_type }}
    # name: left-screw
    params:
      size: M3-0.5
      length: 16
    # TODO: consider zOffset + using port of the box (?)
    connect:
      toInstance: outer-left
      name: lid
